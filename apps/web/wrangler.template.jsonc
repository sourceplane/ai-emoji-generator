// The source of wrangler.jsonc, which tooling/wire renders from it: from
// wiring.fixture.json for local work (`pnpm run wire:fixture`, committed as
// that render), and on every Orun lane from the wiring documents the
// `cloudflare-d1`, `cloudflare-r2` and `cloudflare-kv` Terraform roots
// lease-publish (WIRING_CLOUDFLARE_{D1,R2,KV}_<ENV>) — dev, which no root
// applies to, from the fixture (component.yaml's buildCommand). Edit this
// file, never wrangler.jsonc. The workers-assets composition deploys one
// environment per job with no wrangler `--env`, so `__ENV__` names the
// environment this is rendered for.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ai-emoji-generator-web",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": { "enabled": true },
  // The emojis (prompt, safety rating, image paths) and the generated API
  // secret — Cloudflare D1.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "@@wiring(cloudflare-d1/__ENV__:d1_database_name)@@",
      "database_id": "@@wiring(cloudflare-d1/__ENV__:d1_database_id)@@"
    }
  ],
  // The generated images, original and background-removed — Cloudflare R2,
  // served by the Worker's /api/images route (the bucket is private).
  "r2_buckets": [
    {
      "binding": "IMAGES",
      "bucket_name": "@@wiring(cloudflare-r2/__ENV__:r2_bucket_name)@@"
    }
  ],
  // The per-visitor daily generation limit — Workers KV.
  "kv_namespaces": [
    {
      "binding": "RATE_LIMIT",
      "id": "@@wiring(cloudflare-kv/__ENV__:app_kv_id)@@"
    }
  ]
}
